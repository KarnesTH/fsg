---
import { getRelativeLocaleUrl } from "astro:i18n";
import { strings, type Locale } from "../i18n";
import { latest } from "../lib/changelog";

interface Props {
    active?: "docs" | "changelog";
    path?: string;
}

const { active, path = "" } = Astro.props;
const locale = (Astro.currentLocale ?? "en") as Locale;
const t = strings[locale];
const locales = Object.keys(strings) as Locale[];
---

<nav class="kd-navbar">
    <div class="kd-navbar-start">
        <a class="kd-navbar-brand" href={getRelativeLocaleUrl(locale, "")}>
            <img src={`${import.meta.env.BASE_URL}/logo.svg`} width="28" height="28" alt="" />
            fsg
        </a>
        <span class="kd-badge kd-badge-outline kd-badge-sm hidden md:inline-flex">v{latest.version}</span>
    </div>
    <div class="kd-navbar-center hidden lg:flex">
        <ul class="kd-menu kd-menu-horizontal">
            <li><a class:list={[{ "kd-active": active === "docs" }]} href={getRelativeLocaleUrl(locale, "installation")}>{t.nav.docs}</a></li>
            <li><a class:list={[{ "kd-active": active === "changelog" }]} href={getRelativeLocaleUrl(locale, "changelog")}>{t.nav.changelog}</a></li>
        </ul>
    </div>
    <div class="kd-navbar-end">
        <button class="kd-search hidden md:inline-flex" type="button" data-search-open>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
            {t.nav.search}
            <kbd class="kd-kbd kd-kbd-sm">{t.nav.searchKey}</kbd>
        </button>
        <button class="kd-btn kd-btn-ghost kd-btn-square md:hidden" type="button" aria-label={t.nav.search} data-search-open><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg></button>
        <details class="kd-select kd-select-sm w-32">
            <summary aria-label={t.language.label}><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6.371c0 4.418 -2.239 6.629 -5 6.629" /><path d="M4 6.371h7" /><path d="M5 9c0 2.144 2.252 3.908 6 4" /><path d="M12 20l4 -9l4 9" /><path d="M19.1 18h-6.2" /><path d="M6.694 3l.793 .582" /></svg>{t.language.name}</summary>
            <ul class="kd-select-options">
                {locales.map((code) => (
                    <li><a class:list={["kd-select-option", { "kd-selected": code === locale }]} href={getRelativeLocaleUrl(code, path)} hreflang={code} lang={code}>{strings[code].language.name}</a></li>
                ))}
            </ul>
        </details>
        <a class="kd-btn kd-btn-ghost kd-btn-square hidden md:inline-flex" href="https://pypi.org/project/fsg/" aria-label={t.nav.pypi}><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5" /><path d="M12 12l8 -4.5" /><path d="M12 12l0 9" /><path d="M12 12l-8 -4.5" /><path d="M16 5.25l-8 4.5" /></svg></a>
        <a class="kd-btn kd-btn-ghost kd-btn-square" href="https://github.com/KarnesTH/fsg" aria-label={t.nav.github}><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg></a>
    </div>
</nav>