---
import { strings, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { features } = strings[locale].home;
---

<section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-10 md:grid-cols-3">
        <div class="flex flex-col gap-3">
            <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M5 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M15 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M7 8l0 8" /><path d="M9 18h6a2 2 0 0 0 2 -2v-5" /><path d="M14 14l3 -3l3 3" /></svg>
            <h3 class="m-0 text-lg font-semibold">{features.gitignore.title}</h3>
            <p class="m-0 text-sm leading-relaxed text-kd-text-muted">{features.gitignore.text}</p>
        </div>
        <div class="flex flex-col gap-3">
            <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>
            <h3 class="m-0 text-lg font-semibold">{features.current.title}</h3>
            <p class="m-0 text-sm leading-relaxed text-kd-text-muted">{features.current.text}</p>
        </div>
        <div class="flex flex-col gap-3">
            <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5" /><path d="M12 12l8 -4.5" /><path d="M12 12l0 9" /><path d="M12 12l-8 -4.5" /><path d="M16 5.25l-8 4.5" /></svg>
            <h3 class="m-0 text-lg font-semibold">{features.dependencies.title}</h3>
            <p class="m-0 text-sm leading-relaxed text-kd-text-muted">{features.dependencies.text}</p>
        </div>
    </div>
</section>
