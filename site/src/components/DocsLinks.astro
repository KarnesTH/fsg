---
import { getRelativeLocaleUrl } from "astro:i18n";
import { strings, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { cards } = strings[locale].home;
---

<section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <a class="kd-card kd-card-hover no-underline" href={getRelativeLocaleUrl(locale, "installation")}>
            <div class="kd-card-body">
                <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3" /><path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3" /><path d="M14 9a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></svg>
                <span class="kd-card-title">{cards.installation.title}</span>
                <p>{cards.installation.text}</p>
            </div>
        </a>
        <a class="kd-card kd-card-hover no-underline" href={getRelativeLocaleUrl(locale, "usage")}>
            <div class="kd-card-body">
                <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7l5 5l-5 5" /><path d="M12 19l7 0" /></svg>
                <span class="kd-card-title">{cards.usage.title}</span>
                <p>{cards.usage.text}</p>
            </div>
        </a>
        <a class="kd-card kd-card-hover no-underline" href={getRelativeLocaleUrl(locale, "markers")}>
            <div class="kd-card-body">
                <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" /><path d="M7 15v-6l2 2l2 -2v6" /><path d="M14 13l2 2l2 -2m-2 2v-6" /></svg>
                <span class="kd-card-title">{cards.markers.title}</span>
                <p>{cards.markers.text}</p>
            </div>
        </a>
        <a class="kd-card kd-card-hover no-underline" href={getRelativeLocaleUrl(locale, "recipes")}>
            <div class="kd-card-body">
                <svg class="text-kd-primary-hover" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6l0 13" /><path d="M12 6l0 13" /><path d="M21 6l0 13" /></svg>
                <span class="kd-card-title">{cards.recipes.title}</span>
                <p>{cards.recipes.text}</p>
            </div>
        </a>
    </div>
</section>
