---
interface Props {
    active: "impressum" | "datenschutz";
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 lg:grid-cols-[220px_minmax(0,1fr)]" lang="de">
    <aside>
        <ul class="kd-menu lg:sticky lg:top-6">
            <li class="kd-menu-title">Rechtliches</li>
            <li><a class:list={[{ "kd-active": active === "impressum" }]} href={`${base}/impressum/`}>Impressum</a></li>
            <li><a class:list={[{ "kd-active": active === "datenschutz" }]} href={`${base}/datenschutz/`}>Datenschutz</a></li>
        </ul>
    </aside>

    <article class="kd-prose">
        <slot />
    </article>
</div>