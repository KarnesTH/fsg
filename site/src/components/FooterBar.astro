---
import { strings, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = strings[locale];
const base = import.meta.env.BASE_URL;
---

<footer class="kd-footer-bar">
    <span>© 2026 Patrick Hähnel · {t.footer.license}</span>
    <span><a class="text-kd-text-faint" href={`${base}/impressum/`} hreflang="de">{t.footer.imprint}</a> · <a class="text-kd-text-faint" href={`${base}/datenschutz/`} hreflang="de">{t.footer.privacy}</a></span>
</footer>