---
import { strings, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { help } = strings[locale].home;
---

<section class="mx-auto max-w-6xl px-6 pb-16">
    <div class="kd-card">
        <div class="kd-card-body flex-col gap-6 p-8 md:flex-row md:items-center md:justify-between">
            <div class="flex flex-col gap-2">
                <span class="kd-card-title text-xl">{help.title}</span>
                <p>{help.text}</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a class="kd-btn kd-btn-outline" href="https://github.com/KarnesTH/fsg/issues"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 9v-1a3 3 0 0 1 6 0v1" /><path d="M8 9h8a6 6 0 0 1 1 3v3a5 5 0 0 1 -10 0v-3a6 6 0 0 1 1 -3" /><path d="M3 13l4 0" /><path d="M17 13l4 0" /><path d="M12 20l0 -6" /><path d="M4 19l3.35 -2" /><path d="M20 19l-3.35 -2" /><path d="M4 7l3.75 2.4" /><path d="M20 7l-3.75 2.4" /></svg>{help.issue}</a>
                <a class="kd-btn kd-btn-outline" href="https://github.com/KarnesTH/fsg"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>{help.contribute}</a>
            </div>
        </div>
    </div>
</section>